{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5433;Database=novahiredb2;Username=postgres;Password=root"
  },
  "JwtSettings": {
    "SecretKey": "YOUR_JWT_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG_SECURE",
    "Issuer": "RecruitmentSAAS",
    "Audience": "RecruitmentSAAS-Users",
    "AccessTokenExpirationMinutes": 10080,
    "RefreshTokenExpirationDays": 7
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 465,
    "SenderName": "Équipe NovaHire",
    "SenderEmail": "your-email@gmail.com",
    "Username": "your-email@gmail.com",
    "Password": "YOUR_GMAIL_APP_PASSWORD",
    "EnableSsl": true,
    "ResetPasswordUrl": "https://localhost:3010/reinitialiser-mot-de-passe"
  },
  "AppSettings": {
    "FrontendUrl": "https://localhost:3010",
    "ApiUrl": "https://localhost:7075",
    "FileUploadPath": "uploads",
    "MaxFileUploadSizeMB": 10
  },
  "AISettings": {
    "PythonServiceUrl": "http://localhost:8000"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:5000"
      }
    }
  },
  "AIService": {
    "Url": "http://localhost:8000",
    "OpenAIApiKey": "your-openai-api-key",
    "UseLocalLLM": false,
    "LocalLLMModel": "ollama/llama2"
  },
  "NeoLedgeTheme": {
    "PrimaryColor": "#FFD700",
    "SecondaryColor": "#000000",
    "AccentColor": "#FFFFFF",
    "CompanyName": "NeoLedge"
  },
  "CloudinarySettings": {
    "CloudName": "YOUR_CLOUDINARY_CLOUD_NAME",
    "ApiKey": "YOUR_CLOUDINARY_API_KEY",
    "ApiSecret": "YOUR_CLOUDINARY_API_SECRET"
  }
}