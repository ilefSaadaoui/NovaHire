<script>
import api from '@/api/axios'
import Sidebar from '@/components/layout/Sidebar.vue'

const STATUS_LABELS = {
  Submitted: 'Soumis',
  UnderReview: 'En cours',
  Shortlisted: 'Présélectionné',
  Interview: 'Entretien',
  Interviewed: 'Interviewé',
  Accepted: 'Accepté',
  Rejected: 'Refusé'
}

const STATUS_COLORS = {
  Submitted: '#94a3b8',
  UnderReview: '#fbbf24',
  Shortlisted: '#10b981',
  Interview: '#818cf8',
  Interviewed: '#a78bfa',
  Accepted: '#10b981',
  Rejected: '#f472b6'
}

export default {
  name: 'JobAnalysis',
  components: { Sidebar },
  data() {
    return {
      id: this.$route.params.id,
      sidebarCollapsed: false,
      loading: true,
      jobTitle: '',
      totalApplications: 0,
      analyzedCount: 0,
      stats: { conversionRate: 0, avgScore: 0 },
      pipelineSteps: [],
      skillsData: [],
      topTalents: [],
      scoreRanges: []
    }
  },
  computed: {
    aiComment() {
      const s = this.stats.avgScore
      if (s >= 80) return `Excellent pool de candidats. Le score moyen de ${s}% indique une très bonne adéquation avec le poste.`
      if (s >= 60) return `Bon niveau global (${s}%). Nous recommandons de concentrer les entretiens sur les profils au-dessus de 75%.`
      if (s > 0)   return `Score moyen de ${s}%. Envisagez de revoir les critères de l'offre pour attirer des profils plus qualifiés.`
      return `Aucune analyse IA effectuée. Lancez l'analyse sur les CVs pour obtenir des insights.`
    }
  },
  async mounted() {
    await this.fetchData()
  },
  methods: {
    async fetchData() {
      this.loading = true
      try {
        const [offerRes, analyticsRes, appsRes] = await Promise.all([
          api.get(`/JobOffer/${this.id}`),
          api.get(`/Recruiter/analytics?jobOfferId=${this.id}`),
          api.get(`/Recruiter/applications?jobOfferId=${this.id}`)
        ])

        // Job title
        this.jobTitle = offerRes.data.title

        // Analytics
        const analytics = analyticsRes.data
        const kpis = analytics.Kpis || analytics.kpis || []
        const convKpi = kpis.find(k => k.Label?.includes('Conversion') || k.label?.includes('Conversion'))
        const scoreKpi = kpis.find(k => k.Label?.includes('Matching') || k.label?.includes('Matching'))
        this.stats.conversionRate = parseInt(convKpi?.Value || convKpi?.value || 0)
        this.stats.avgScore = parseInt(scoreKpi?.Value || scoreKpi?.value || 0)

        // Pipeline
        const pipeline = analytics.PipelineData || analytics.pipelineData || []
        const totalPipe = pipeline.reduce((s, p) => s + (p.Count || p.count || 0), 0)
        this.pipelineSteps = pipeline
          .filter(p => (p.Count || p.count || 0) > 0)
          .map(p => {
            const name = p.Name || p.name || ''
            const count = p.Count || p.count || 0
            return {
              name: STATUS_LABELS[name] || name,
              count,
              percentage: totalPipe > 0 ? Math.round(count / totalPipe * 100) : 0,
              color: STATUS_COLORS[name] || '#6C63FF'
            }
          })

        // Score ranges
        const ranges = analytics.ScoreRanges || analytics.scoreRanges || []
        const rangeColors = { high: '#10b981', mid: '#f59e0b', low: '#f472b6' }
        this.scoreRanges = ranges.map(r => ({
          label: r.Label || r.label,
          count: r.Count || r.count || 0,
          color: rangeColors[r.Class || r.class] || '#6C63FF'
        }))

        // Top skills
        const skills = analytics.TopSkills || analytics.topSkills || []
        const maxCount = skills.length > 0 ? Math.max(...skills.map(s => s.Count || s.count || 0)) : 1
        this.skillsData = skills.slice(0, 6).map(s => ({
          name: s.Name || s.name,
          count: s.Count || s.count || 0,
          pct: Math.round((s.Count || s.count || 0) / maxCount * 100)
        }))

        // Applications
        const apps = appsRes.data?.data || appsRes.data || []
        this.totalApplications = Array.isArray(apps) ? apps.length : 0
        this.analyzedCount = Array.isArray(apps) ? apps.filter(a => a.aiScore != null).length : 0

        // Top 3 talents by AI score
        this.topTalents = [...apps]
          .filter(a => a.aiScore != null)
          .sort((a, b) => (b.aiScore || 0) - (a.aiScore || 0))
          .slice(0, 3)
          .map(a => ({
            id: a.id,
            name: a.candidateName || a.candidate?.fullName || 'Candidat',
            status: STATUS_LABELS[a.status] || a.status,
            score: a.aiScore || 0
          }))

      } catch (err) {
        console.error('Erreur dossier:', err)
      } finally {
        this.loading = false
      }
    }
  }
}
</script>

