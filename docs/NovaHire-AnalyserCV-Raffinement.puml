@startuml NovaHire-AnalyserCV-Raffinement
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
}

actor "Recruteur" as R
actor "Service IA" as IA

rectangle "Analyser le CV d'une candidature <<raffinement>>" {

  usecase "Consulter\nla candidature" as UC1
  usecase "Vérifier la présence\ndu CV" as UC2
  usecase "Transmettre le CV\net l'offre au service IA" as UC3
  usecase "Extraire les informations\ndu CV" as UC4
  usecase "Calculer le score\nde matching" as UC5
  usecase "Enregistrer les résultats\nde l'analyse" as UC6
  usecase "Afficher le diagnostic IA\nau recruteur" as UC7
  usecase "Mettre à jour le statut\nde la candidature" as UC8

  UC1 ..> UC2 : <<include>>
  UC2 ..> UC3 : <<include>>
  UC3 ..> UC4 : <<include>>
  UC4 ..> UC5 : <<include>>
  UC5 ..> UC6 : <<include>>
  UC6 ..> UC7 : <<include>>
  UC7 ..> UC8 : <<extend>>

}

R --> UC1
IA --> UC4
IA --> UC5

note bottom of UC8
  Passage à « En cours d'examen »
  ou « Refusée » si seuil
  de rejet configuré
end note

@enduml
